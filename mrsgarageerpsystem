        // --- QUOTATIONS MODULE (WITH INSURANCE + VAT/TAX SUPPORT) ---
        window.quotationInsuranceActive = false;
        window.quotationTaxActive = false;

        window.getQuotationTotals = function(quo) {
            const pSum = (quo.parts || []).reduce((a, b) => a + (parseFloat(b.qty) || 0) * (parseFloat(b.price) || 0), 0);
            const lSum = (quo.labor || []).reduce((a, b) => a + (parseFloat(b.qty) || 0) * (parseFloat(b.price) || 0), 0);
            const subtotal = pSum + lSum;
            const applyTax = quo.taxEnabled !== undefined ? !!quo.taxEnabled : !!window.workshopSettings.taxEnabled;
            const rate = parseFloat(quo.taxRate ?? window.workshopSettings.taxRate) || 0;
            const taxAmt = applyTax ? (subtotal * rate) / 100 : 0;
            return { subtotal, applyTax, rate, taxAmt, grandTotal: subtotal + taxAmt };
        };

        window.setQuotationTaxUI = function(isTax) {
            window.quotationTaxActive = !!isTax;
            const rate = parseFloat(window.workshopSettings.taxRate) || 18;
            syncSwitchUI('quo-switch-tax', 'quo-thumb-tax', window.quotationTaxActive, 'bg-amber-500', 'bg-slate-400', false);
            if (window.getEl('quo-modal-tax-pct')) window.getEl('quo-modal-tax-pct').innerText = rate;
            if (window.getEl('quo-modal-tax-rate-label')) window.getEl('quo-modal-tax-rate-label').innerText = rate;
            const taxRow = window.getEl('quo-modal-tax-row');
            if (taxRow) {
                if (window.quotationTaxActive) taxRow.classList.remove('hidden');
                else taxRow.classList.add('hidden');
            }
        };

        window.toggleQuotationTax = function() {
            window.setQuotationTaxUI(!window.quotationTaxActive);
            window.calculateQuotationTotal();
        };

        window.setQuotationInsuranceUI = function(isIns) {
            window.quotationInsuranceActive = !!isIns;
            syncSwitchUI('quo-switch-insurance', 'quo-thumb-insurance', window.quotationInsuranceActive, 'bg-indigo-600', 'bg-slate-400', false);
            const panel = window.getEl('quo-insurance-panel');
            const label = window.getEl('quo-ins-status-label');
            if (panel) {
                if (window.quotationInsuranceActive) panel.classList.remove('hidden');
                else panel.classList.add('hidden');
            }
            if (label) {
                label.innerText = window.quotationInsuranceActive ? 'INSURANCE CLAIM' : 'REGULAR';
                label.className = window.quotationInsuranceActive
                    ? 'text-[11px] font-extrabold text-indigo-700 dark:text-indigo-300'
                    : 'text-[11px] font-extrabold text-slate-500';
            }
        };

        window.toggleQuotationInsurance = function() {
            window.setQuotationInsuranceUI(!window.quotationInsuranceActive);
        };

        window.addQuoPartRow = (desc = '', qty = 1, price = '') => { const c = window.getEl('quo-parts-container'); if (c) c.appendChild(window.createSearchableRow('Part', window.calculateQuotationTotal, desc, qty, price)); };
        window.addQuoLaborRow = (desc = '', qty = 1, price = '') => { const c = window.getEl('quo-labor-container'); if (c) c.appendChild(window.createSearchableRow('Labor', window.calculateQuotationTotal, desc, qty, price)); };

        window.calculateQuotationTotal = function() {
            let subtotal = 0;
            document.querySelectorAll('#quo-parts-container .item-row, #quo-labor-container .item-row').forEach(row => {
                const qty = parseFloat(row.querySelector('.row-qty').value) || 0;
                const price = parseFloat(row.querySelector('.row-price').value) || 0;
                subtotal += qty * price;
            });
            const rate = parseFloat(window.workshopSettings.taxRate) || 0;
            const taxAmt = window.quotationTaxActive ? (subtotal * rate) / 100 : 0;
            const grandTotal = subtotal + taxAmt;

            if (window.getEl('quo-sub-display')) window.getEl('quo-sub-display').innerText = `LKR ${subtotal.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            if (window.getEl('quo-tax-display')) window.getEl('quo-tax-display').innerText = `LKR ${taxAmt.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            if (window.getEl('quo-total-display')) window.getEl('quo-total-display').innerText = `LKR ${grandTotal.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
        };

        window.saveQuotation = function(e) {
            e.preventDefault();
            const existingId = window.getEl('quo-id').value;
            const id = existingId || `QUO-${Math.floor(1000 + Math.random() * 9000)}`;
            const date = window.getEl('quo-date').value;
            const validUntil = window.getEl('quo-valid').value;
            const custName = window.getEl('quo-cust-name').value;
            const custPhone = window.getEl('quo-cust-phone').value;
            const vehNo = window.getEl('quo-veh-no').value.toUpperCase();
            const vehModel = window.getEl('quo-veh-model').value;
            const odometer = window.getEl('quo-odometer').value;
            const terms = window.getEl('quo-terms').value || DEFAULT_QUOTATION_TERMS;

            const taxEnabled = !!window.quotationTaxActive;
            const taxRate = parseFloat(window.workshopSettings.taxRate) || 18;

            const isInsurance = !!window.quotationInsuranceActive;
            const insCompany = isInsurance ? (window.getEl('quo-ins-company')?.value.trim() || '') : '';
            const insClaimNo = isInsurance ? (window.getEl('quo-ins-claim')?.value.trim().toUpperCase() || '') : '';
            const insAssessor = isInsurance ? (window.getEl('quo-ins-assessor')?.value.trim() || '') : '';
            const insAccidentDate = isInsurance ? (window.getEl('quo-ins-accident-date')?.value || '') : '';

            const parts = [];
            document.querySelectorAll('#quo-parts-container .item-row').forEach(row => {
                const desc = row.querySelector('.row-desc').value.trim();
                const qty = parseFloat(row.querySelector('.row-qty').value) || 0;
                const price = parseFloat(row.querySelector('.row-price').value) || 0;
                if (desc) parts.push({ desc, qty, price });
            });

            const labor = [];
            document.querySelectorAll('#quo-labor-container .item-row').forEach(row => {
                const desc = row.querySelector('.row-desc').value.trim();
                const qty = parseFloat(row.querySelector('.row-qty').value) || 0;
                const price = parseFloat(row.querySelector('.row-price').value) || 0;
                if (desc) labor.push({ desc, qty, price });
            });

            const quoObj = { id, date, validUntil, custName, custPhone, vehNo, vehModel, odometer, taxEnabled, taxRate, isInsurance, insCompany, insClaimNo, insAssessor, insAccidentDate, terms, parts, labor };
            const idx = window.quotations.findIndex(q => q.id === id);
            if (idx >= 0) window.quotations[idx] = quoObj;
            else window.quotations.push(quoObj);

            window.syncCustomerFromRecord({ custName, custPhone, vehNo, vehModel });
            saveState();
            window.closeModal('quotationModal');
            window.refreshSystemData();
            window.showToast(`${isInsurance ? 'Insurance ' : ''}Quotation ${id} saved!`);
        };

        window.editQuotation = function(id) {
            const quo = window.quotations.find(q => q.id === id);
            if (!quo) return;
            window.openModal('quotationModal');
            window.getEl('quotationModalTitle').innerHTML = `<i class="fa-solid fa-pen text-blue-400"></i> Edit Service Quotation (${quo.id})`;
            window.getEl('quo-id').value = quo.id;
            window.getEl('quo-date').value = quo.date;
            window.getEl('quo-valid').value = quo.validUntil;
            window.getEl('quo-cust-name').value = quo.custName;
            window.getEl('quo-cust-phone').value = quo.custPhone;
            window.getEl('quo-veh-no').value = quo.vehNo;
            window.getEl('quo-veh-model').value = quo.vehModel;
            window.getEl('quo-odometer').value = quo.odometer || '';
            window.getEl('quo-terms').value = quo.terms || DEFAULT_QUOTATION_TERMS;

            const hasTax = quo.taxEnabled !== undefined ? !!quo.taxEnabled : !!window.workshopSettings.taxEnabled;
            window.setQuotationTaxUI(hasTax);

            window.setQuotationInsuranceUI(!!quo.isInsurance);
            if (window.getEl('quo-ins-company')) window.getEl('quo-ins-company').value = quo.insCompany || '';
            if (window.getEl('quo-ins-claim')) window.getEl('quo-ins-claim').value = quo.insClaimNo || '';
            if (window.getEl('quo-ins-assessor')) window.getEl('quo-ins-assessor').value = quo.insAssessor || '';
            if (window.getEl('quo-ins-accident-date')) window.getEl('quo-ins-accident-date').value = quo.insAccidentDate || '';

            window.getEl('quo-parts-container').innerHTML = '';
            window.getEl('quo-labor-container').innerHTML = '';
            if (quo.parts && quo.parts.length) quo.parts.forEach(p => window.addQuoPartRow(p.desc, p.qty, p.price)); else window.addQuoPartRow();
            if (quo.labor && quo.labor.length) quo.labor.forEach(l => window.addQuoLaborRow(l.desc, l.qty, l.price)); else window.addQuoLaborRow();
            window.calculateQuotationTotal();
        };

        window.deleteQuotation = function(id) {
            const quo = window.quotations.find(q => q.id === id);
            if (quo) window.moveToRecycleBin('Quotation', `${quo.id} (${quo.vehNo})`, quo);
            window.quotations = window.quotations.filter(q => q.id !== id);
            saveState();
            window.refreshSystemData();
            window.showToast('Quotation moved to Recycle Bin');
        };

        window.renderQuotations = function() {
            const tbody = window.getEl('quotations-list');
            if (!tbody) return;
            tbody.innerHTML = '';
            const q = (window.getEl('quotation-search')?.value || '').toLowerCase();
            const filtered = window.quotations.filter(item =>
                item.id.toLowerCase().includes(q) ||
                item.custName.toLowerCase().includes(q) ||
                item.vehNo.toLowerCase().includes(q) ||
                (item.insCompany || '').toLowerCase().includes(q)
            );

            if (!filtered.length) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-400">No quotations found. Click "+ New Quotation" to create one.</td></tr>`;
                return;
            }

            filtered.slice().reverse().forEach(quo => {
                const { grandTotal, applyTax, rate } = window.getQuotationTotals(quo);
                const insBadge = quo.isInsurance
                    ? `<div class="mt-0.5"><span class="px-1.5 py-0.5 rounded bg-indigo-100 text-indigo-800 text-[9px] font-extrabold"><i class="fa-solid fa-shield-halved mr-0.5"></i> ${quo.insCompany || 'Insurance Claim'}</span></div>`
                    : '';
                const vatTag = applyTax ? `<div class="text-[9px] font-bold text-amber-600 dark:text-amber-400">Incl. ${rate}% VAT</div>` : '';
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
