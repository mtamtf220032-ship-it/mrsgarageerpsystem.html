        window.renderCashbook = function () {
            const dateInput = document.getElementById('cashbook-date-filter');
            if (!dateInput.value) dateInput.value = new Date().toISOString().split('T')[0];
            const dt = dateInput.value;

            const cbMap = loadDB(KEYS.CASHBOOK, {});
            const openVal = parseFloat(cbMap[dt]) || 0;
            document.getElementById('cb-opening-input').value = openVal;

            const jobs = loadDB(KEYS.JOBS, []).filter(j => j.date === dt);
            const exps = loadDB(KEYS.EXPENSES, []).filter(e => e.date === dt);

            const cashIn = jobs.reduce((a, j) => a + (parseFloat(j.paidAmount) || 0), 0);
            const cashOut = exps.reduce((a, e) => a + (parseFloat(e.amount) || 0), 0);
            const closing = openVal + cashIn - cashOut;

            document.getElementById('cb-cash-in').textContent = fmtMoney(cashIn);
            document.getElementById('cb-cash-out').textContent = fmtMoney(cashOut);
            document.getElementById('cb-closing-balance').textContent = fmtMoney(closing);
        };

