            if (!job) return;
            const net = window.getJobNetTotal(job);
            const bal = window.getJobBalanceDue(job);
            const msg = `${window.workshopSettings.name}: Hello ${job.custName}, work on your vehicle ${job.vehNo} (${job.id}) is COMPLETED! Total: LKR ${net.toLocaleString()}, Balance Due: LKR ${bal.toLocaleString()}. Ready for pickup!${window.getClosedGarageNotice()}`;
            const cleanPhone = (job.custPhone || '').replace(/\D/g, '').replace(/^0/, '94');
            if (channel === 'whatsapp') window.open(`https://wa.me/${cleanPhone}?text=${encodeURIComponent(msg)}`, '_blank');
            else window.open(`sms:${job.custPhone}?body=${encodeURIComponent(msg)}`, '_self');
        };

