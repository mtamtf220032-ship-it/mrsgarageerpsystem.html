        /* =========================================================================================
         * 9. JSON BACKUP & RESTORE
         * ========================================================================================= */
        window.quickJsonBackup = function () {
            const dump = {};
            Object.values(KEYS).forEach(k => {
                const raw = localStorage.getItem(k);
                if (raw) dump[k] = JSON.parse(raw);
            });
            const blob = new Blob([JSON.stringify(dump, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `MRS_GARAGE_BACKUP_${new Date().toISOString().split('T')[0]}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('Full JSON Backup downloaded!');
        };

        window.restoreJsonBackup = function (e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (ev) {
                try {
                    const data = JSON.parse(ev.target.result);
                    Object.entries(data).forEach(([k, v]) => localStorage.setItem(k, JSON.stringify(v)));
                    if (window.pushLocalStateToFirebase) window.pushLocalStateToFirebase();
                    loadSettingsToUI();
                    refreshAllUI();
                    showToast('Backup restored & synced!');
                } catch (err) {
                    showToast('Invalid JSON backup file!');
                }
            };
            reader.readAsText(file);
        };

        function refreshAllUI() {
            renderDashboard();
            renderJobCards();
            renderInvoices();
            renderQuotations();
            renderCustomers();
            renderInventory();
            renderRawMaterials();
            renderServices();
            renderStaff();
            renderExpenses();
            renderSuppliers();
            renderCashbook();
            renderFinancialReport();
        }
        window.refreshAllUI = refreshAllUI;

        /* =========================================================================================
         * 10. INITIALIZE ON PAGE LOAD
         * ========================================================================================= */
        window.addEventListener('DOMContentLoaded', () => {
            seedIfEmpty();
            loadSettingsToUI();
            const s = getSettings();
            if (s.appPassword) {
                document.getElementById('lock-ws-title').textContent = s.name || 'MRS GARAGE';
                document.getElementById('startup-lock-screen').classList.remove('hidden');
            }
            refreshAllUI();
        });
    </script>
