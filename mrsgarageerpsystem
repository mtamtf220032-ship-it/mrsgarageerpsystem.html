                if (roomInput) roomInput.value = roomCode;

                if (fbUnsub) fbUnsub();
                const roomDocRef = doc(fbDb, 'artifacts', 'mrs-garage-app', 'public', 'data', 'workshop_rooms', roomCode);

                fbUnsub = onSnapshot(roomDocRef, (snap) => {
                    setSyncIndicator(true, `Live: ${roomCode}`);
                    if (!snap.exists()) {
                        pushLocalStateToFirebase(roomCode);
                        return;
                    }
                    const remoteData = snap.data();
                    if (!remoteData || !remoteData.payload) return;
                    const localUpdated = parseInt(localStorage.getItem('mrs_last_updated') || '0', 10);
                    if ((remoteData.updatedAt || 0) > localUpdated) {
                        isApplyingRemote = true;
                        Object.entries(remoteData.payload).forEach(([k, v]) => {
                            if (v !== undefined && v !== null) {
                                localStorage.setItem(k, JSON.stringify(v));
                            }
                        });
                        localStorage.setItem('mrs_last_updated', String(remoteData.updatedAt));
                        if (window.loadSettingsToUI) window.loadSettingsToUI();
                        if (window.refreshAllUI) window.refreshAllUI();
                        isApplyingRemote = false;
                    }
                }, (err) => {
                    console.warn('Firestore snapshot warning:', err);
                    setSyncIndicator(false, 'Local Mode');
                });
            } catch (err) {
                console.warn('Firebase fallback to local:', err);
                setSyncIndicator(false, 'Local Mode');
            }
        }

        async function pushLocalStateToFirebase(roomOverride = null) {
            if (!fbDb || isApplyingRemote) return;
            try {
                const roomCode = (roomOverride || localStorage.getItem('mrs_sync_room') || 'MRS-GARAGE-MAIN').toUpperCase().trim();
                const roomDocRef = doc(fbDb, 'artifacts', 'mrs-garage-app', 'public', 'data', 'workshop_rooms', roomCode);
                const payload = {};
                ['mrs_jobs', 'mrs_quotes', 'mrs_inventory', 'mrs_rawmaterials', 'mrs_services', 'mrs_customers', 'mrs_staff', 'mrs_expenses', 'mrs_suppliers', 'mrs_cashbook_open', 'mrs_settings'].forEach(k => {
                    const raw = localStorage.getItem(k);
                    if (raw) payload[k] = JSON.parse(raw);
                });
                const now = Date.now();
                localStorage.setItem('mrs_last_updated', String(now));
                await setDoc(roomDocRef, { updatedAt: now, payload }, { merge: true });
            } catch (err) {
                console.warn('Firebase sync write warning:', err);
            }
        }

        window.pushLocalStateToFirebase = pushLocalStateToFirebase;
        window.reconnectFirebaseRoom = () => {
            const room = document.getElementById('set-sync-room').value.trim() || 'MRS-GARAGE-MAIN';
            initFirebaseCloudSync(room).then(() => {
                pushLocalStateToFirebase(room);
                if (window.showToast) window.showToast('Synced with Cloud Room: ' + room);
            });
        };

        window.addEventListener('DOMContentLoaded', () => initFirebaseCloudSync());
    </script>

