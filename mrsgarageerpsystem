<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#090d16">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>MRS GARAGE - Workshop Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    },
                    colors: {
                        navy: {
                            800: '#1e293b',
                            900: '#0f172a',
                            950: '#090d16'
                        }
                    }
                }
            }
        };
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .tab-btn.active {
            background-color: #f59e0b;
            color: #090d16;
            font-weight: 800;
        }
        .toggle-track { transition: background-color 0.22s ease; }
        .toggle-thumb { transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1); }
        @media (max-width: 640px) {
            input, select, textarea { font-size: 16px !important; }
            .mobile-card-table thead { display: none; }
            .mobile-card-table tbody { display: block; padding: 0.5rem; }
            .mobile-card-table tbody tr {
                display: block;
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 0.85rem;
                margin-bottom: 0.75rem;
                padding: 0.75rem;
                box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
            }
            .dark .mobile-card-table tbody tr {
                background: #0f172a;
                border-color: #1e293b;
            }
            .mobile-card-table tbody td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0.35rem 0.25rem !important;
                border-bottom: 1px dashed #e2e8f0;
                text-align: right !important;
                gap: 0.5rem;
            }
            .dark .mobile-card-table tbody td { border-bottom-color: #1e293b; }
            .mobile-card-table tbody td:last-child {
                border-bottom: none;
                justify-content: flex-end;
                padding-top: 0.6rem !important;
                margin-top: 0.25rem;
                border-top: 1px solid #e2e8f0;
                flex-wrap: wrap;
            }
            .mobile-card-table tbody td[colspan] { display: block; text-align: center !important; border: none; }
            .mobile-card-table tbody td::before {
                content: attr(data-label);
                font-weight: 700;
                font-size: 10px;
                text-transform: uppercase;
                color: #64748b;
                text-align: left;
                flex-shrink: 0;
            }
            .mobile-card-table tbody td[colspan]::before,
            .mobile-card-table tbody td:last-child::before { display: none; }
        }
        @media print {
            @page {
                size: A4 portrait;
                margin: 10mm 10mm 15mm 10mm;
            }
            body * { visibility: hidden; }
            #document-print-area, #document-print-area *,
            #financial-report-print-area, #financial-report-print-area * { visibility: visible; }
            #document-print-area.active-print,
            #financial-report-print-area.active-print {
                position: absolute; left: 0; top: 0; width: 100%;
                background: #ffffff !important; color: #000000 !important; padding: 2mm !important;
            }
            .print-break-avoid { break-inside: avoid; page-break-inside: avoid; }
            .print-page-footer {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                display: flex;
                justify-content: space-between;
                font-size: 9.5pt;
                font-weight: 700;
                color: #334155;
                border-top: 1px solid #cbd5e1;
                padding-top: 3px;
                background: #ffffff;
            }
            .print-page-counter::after {
                content: "Page " counter(pages) "-" counter(page);
            }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col pb-20 sm:pb-0 transition-colors duration-200">

    <!-- STARTUP PASSWORD LOCK OVERLAY -->
    <div id="startup-lock-screen" class="fixed inset-0 bg-navy-950/95 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white dark:bg-slate-900 rounded-2xl max-w-sm w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800 space-y-4">
            <div class="text-center space-y-1">
                <div class="w-12 h-12 rounded-2xl bg-amber-500 text-navy-950 flex items-center justify-center font-black text-xl mx-auto shadow">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <h2 id="lock-ws-title" class="font-black text-lg text-navy-950 dark:text-white">MRS GARAGE</h2>
                <p class="text-xs text-slate-500">Workshop Security Lock &bull; Enter Startup Password</p>
            </div>
            <div class="space-y-3">
                <input type="password" id="unlock-password-input" onkeydown="if(event.key==='Enter') window.attemptUnlockApp()" placeholder="Enter Password" class="w-full p-3 border border-slate-300 dark:border-slate-700 dark:bg-slate-800 rounded-xl text-sm font-bold text-center focus:ring-2 focus:ring-amber-400 outline-none">
                <button type="button" onclick="window.attemptUnlockApp()" class="w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-navy-950 font-extrabold rounded-xl text-xs shadow">
                    <i class="fa-solid fa-unlock mr-1"></i> Unlock System
                </button>
            </div>
        </div>
    </div>

    <!-- 4-DIGIT ADMIN PIN MODAL -->
    <div id="adminPinModal" class="fixed inset-0 bg-slate-900/75 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-white dark:bg-slate-900 rounded-2xl max-w-xs w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800 space-y-4 text-center">
            <div class="w-11 h-11 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-lg mx-auto">
                <i class="fa-solid fa-key"></i>
            </div>
            <div>
                <h3 class="font-black text-base text-navy-950 dark:text-white">Owner Admin PIN</h3>
                <p class="text-xs text-slate-500">Enter 4-Digit PIN to access Financial &amp; Cashbook</p>
            </div>
            <input type="password" id="admin-pin-verify-input" maxlength="4" inputmode="numeric" onkeydown="if(event.key==='Enter') window.verifyAdminPinEntry()" placeholder="••••" class="w-full p-3 border border-indigo-300 dark:border-indigo-700 dark:bg-slate-800 rounded-xl text-center font-mono text-lg font-black tracking-[0.5em] focus:ring-2 focus:ring-indigo-500 outline-none">
            <div class="flex gap-2">
                <button type="button" onclick="window.closeModal('adminPinModal')" class="flex-1 py-2 border border-slate-300 dark:border-slate-700 rounded-xl text-xs font-bold">Cancel</button>
                <button type="button" onclick="window.verifyAdminPinEntry()" class="flex-1 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-extrabold">Unlock</button>
            </div>
        </div>
    </div>

    <!-- TOP NAVIGATION HEADER -->
    <header class="bg-navy-950 text-white shadow-lg sticky top-0 z-40 no-print">
        <div class="max-w-7xl mx-auto px-3 sm:px-4 py-2.5 sm:py-3 flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-10 h-10 rounded-xl bg-amber-500 text-navy-950 flex items-center justify-center font-black text-lg shadow overflow-hidden shrink-0 border border-amber-400/50">
                    <img id="header-workshop-logo" src="" alt="Logo" class="w-full h-full object-contain bg-white hidden">
                    <i id="header-workshop-icon" class="fa-solid fa-wrench"></i>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <h1 id="header-workshop-name" class="font-black text-sm sm:text-lg tracking-wide text-amber-400 truncate">MRS GARAGE</h1>
                        <span class="hidden md:inline-block px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-amber-500/20 text-amber-300 border border-amber-500/30">PRO ERP</span>
                    </div>
                    <p id="header-workshop-tagline" class="text-[10px] sm:text-[11px] text-slate-400 truncate">Complete Automotive Repair &amp; Service Management</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 shrink-0">
                <!-- GARAGE OPEN/CLOSED SWITCH -->
                <div class="flex items-center gap-1.5 bg-slate-800/90 border border-slate-700 px-2.5 py-1.5 rounded-lg" title="Toggle Workshop Open/Closed Status">
                    <span id="garage-open-label" class="text-[10px] font-extrabold text-emerald-400 flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> OPEN
                    </span>
                    <button type="button" role="switch" id="switch-garage-open" onclick="window.toggleGarageOpen()"
                        class="toggle-track relative inline-flex h-4 w-8 shrink-0 cursor-pointer rounded-full bg-emerald-500 p-0.5 focus:outline-none">
                        <span id="thumb-garage-open" class="toggle-thumb pointer-events-none inline-block h-3 w-3 transform rounded-full bg-white shadow translate-x-4"></span>
                    </button>
                </div>

                <!-- DARK MODE SWITCH -->
                <div class="flex items-center gap-1.5 bg-slate-800/90 border border-slate-700 px-2.5 py-1.5 rounded-lg" title="Toggle Dark / Light Mode">
                    <i id="theme-switch-icon" class="fa-solid fa-sun text-amber-400 text-[11px]"></i>
                    <button type="button" role="switch" id="switch-dark-mode" onclick="window.toggleDarkMode()"
                        class="toggle-track relative inline-flex h-4 w-8 shrink-0 cursor-pointer rounded-full bg-slate-600 p-0.5 focus:outline-none">
                        <span id="thumb-dark-mode" class="toggle-thumb pointer-events-none inline-block h-3 w-3 transform rounded-full bg-white shadow translate-x-0"></span>
                    </button>
                </div>

                <!-- FIREBASE LIVE SYNC STATUS PILL -->
                <span id="live-sync-pill" onclick="window.switchTab('settings')" class="cursor-pointer bg-slate-800 border border-slate-700 text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] sm:text-xs font-bold flex items-center gap-1.5" title="Firebase Multi-Device Live Sync">
                    <span id="live-sync-dot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                    <span id="live-sync-text">Connecting...</span>
                </span>

                <button type="button" onclick="window.openDocEditor('job')" class="bg-amber-500 hover:bg-amber-400 active:scale-95 text-navy-950 font-extrabold px-2.5 sm:px-3 py-1.5 rounded-lg text-xs shadow transition">
                    + Job<span class="hidden sm:inline"> Card</span>
                </button>
                <button type="button" onclick="window.openDocEditor('quote')" class="bg-blue-600 hover:bg-blue-500 active:scale-95 text-white font-bold px-2.5 sm:px-3 py-1.5 rounded-lg text-xs shadow transition">
                    + Quote<span class="hidden sm:inline">ation</span>
                </button>
                <button type="button" id="header-lock-all-btn" onclick="window.lockAllDevicesNow()" class="hidden bg-red-600 hover:bg-red-500 active:scale-95 text-white font-bold px-2.5 py-1.5 rounded-lg text-xs shadow transition items-center gap-1" title="Lock System">
                    <i class="fa-solid fa-lock"></i>
                </button>
                <button type="button" onclick="window.quickJsonBackup()" class="bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-bold px-2.5 py-1.5 rounded-lg text-xs shadow transition flex items-center gap-1" title="Download Full JSON Backup">
                    <i class="fa-solid fa-download"></i> <span class="hidden xl:inline">Backup</span>
                </button>
            </div>
        </div>

        <!-- SCROLLABLE TAB BAR -->
        <nav class="bg-navy-900 border-t border-slate-800 overflow-x-auto">
            <div class="max-w-7xl mx-auto px-3 sm:px-4 py-2 flex items-center gap-1.5 text-xs whitespace-nowrap">
                <button type="button" onclick="window.switchTab('dashboard')" data-tab="dashboard" class="tab-btn active px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-gauge-high mr-1"></i> Dashboard
                </button>
                <button type="button" onclick="window.switchTab('jobcards')" data-tab="jobcards" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-clipboard-list mr-1"></i> Job Cards
                </button>
                <button type="button" onclick="window.switchTab('invoices')" data-tab="invoices" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-file-invoice mr-1"></i> Tax Invoices
                </button>
                <button type="button" onclick="window.switchTab('quotations')" data-tab="quotations" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-file-invoice-dollar mr-1"></i> Quotations
                </button>
                <button type="button" onclick="window.switchTab('financial')" data-tab="financial" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-chart-pie mr-1"></i> Financial &amp; Cashbook
                </button>
                <button type="button" onclick="window.switchTab('suppliers')" data-tab="suppliers" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-truck-field mr-1"></i> Suppliers
                </button>
                <button type="button" onclick="window.switchTab('expenses')" data-tab="expenses" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-receipt mr-1"></i> Expenses
                </button>
                <button type="button" onclick="window.switchTab('inventory')" data-tab="inventory" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-boxes-stacked mr-1"></i> Spare Parts DB
                </button>
                <button type="button" onclick="window.switchTab('rawmaterials')" data-tab="rawmaterials" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-fill-drip mr-1"></i> Raw Materials DB
                </button>
                <button type="button" onclick="window.switchTab('services')" data-tab="services" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-screwdriver-wrench mr-1"></i> Labor &amp; Services DB
                </button>
                <button type="button" onclick="window.switchTab('customers')" data-tab="customers" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-users mr-1"></i> Customers
                </button>
                <button type="button" onclick="window.switchTab('staff')" data-tab="staff" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-user-gear mr-1"></i> Staff
                </button>
                <button type="button" onclick="window.switchTab('settings')" data-tab="settings" class="tab-btn px-3 py-2 sm:py-1.5 rounded-lg text-slate-300 hover:bg-navy-800 transition">
                    <i class="fa-solid fa-gear mr-1"></i> Settings &amp; Letterhead
                </button>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="max-w-7xl w-full mx-auto px-3 sm:px-4 py-4 sm:py-6 flex-1 space-y-5 sm:space-y-6">

        <!-- 1. DASHBOARD VIEW -->
        <section id="view-dashboard" class="tab-content space-y-6">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                <div onclick="window.switchTab('jobcards')" class="cursor-pointer bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm hover:border-amber-400 transition">
                    <div class="flex items-center justify-between">
                        <span class="text-[11px] font-bold text-slate-500 uppercase">Active Job Cards</span>
                        <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center text-xs"><i class="fa-solid fa-wrench"></i></div>
                    </div>
                    <h3 id="stat-active-jobs" class="text-2xl font-black text-navy-950 dark:text-white mt-2 font-mono">0</h3>
                    <p class="text-[10px] text-slate-400 mt-0.5">In Progress &amp; Waiting Parts</p>
                </div>

                <div onclick="window.switchTab('invoices')" class="cursor-pointer bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm hover:border-emerald-400 transition">
                    <div class="flex items-center justify-between">
                        <span class="text-[11px] font-bold text-slate-500 uppercase">Collected Revenue</span>
                        <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs"><i class="fa-solid fa-coins"></i></div>
                    </div>
                    <h3 id="stat-total-revenue" class="text-lg sm:text-xl font-black text-emerald-700 dark:text-emerald-400 mt-2 font-mono truncate">LKR 0.00</h3>
                    <p class="text-[10px] text-slate-400 mt-0.5">Paid &amp; Advance Payments</p>
                </div>

                <div onclick="window.switchTab('invoices')" class="cursor-pointer bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm hover:border-red-400 transition">
                    <div class="flex items-center justify-between">
                        <span class="text-[11px] font-bold text-slate-500 uppercase">Pending Balance Due</span>
                        <div class="w-8 h-8 rounded-lg bg-red-100 text-red-700 flex items-center justify-center text-xs"><i class="fa-solid fa-clock"></i></div>
                    </div>
                    <h3 id="stat-pending-amount" class="text-lg sm:text-xl font-black text-red-600 dark:text-red-400 mt-2 font-mono truncate">LKR 0.00</h3>
                    <p class="text-[10px] text-slate-400 mt-0.5">Unpaid Customer Balances</p>
                </div>

                <div onclick="window.switchTab('customers')" class="cursor-pointer bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm hover:border-blue-400 transition">
                    <div class="flex items-center justify-between">
                        <span class="text-[11px] font-bold text-slate-500 uppercase">Registered Vehicles</span>
                        <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-xs"><i class="fa-solid fa-car"></i></div>
                    </div>
                    <h3 id="stat-total-customers" class="text-2xl font-black text-navy-950 dark:text-white mt-2 font-mono">0</h3>
                    <p class="text-[10px] text-slate-400 mt-0.5">Customer &amp; Fleet Directory</p>
                </div>
            </div>

            <!-- WORKSHOP LIVE SWITCHES & PRINT CONTROLS -->
            <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h2 class="font-black text-navy-950 dark:text-white text-sm">Workshop Live Switches &amp; Print Controls</h2>
                    <p class="text-[11px] text-slate-500">All switches save automatically and sync across Job Cards, Invoices &amp; Quotations.</p>
                </div>
                <div class="flex flex-wrap items-center gap-2.5 text-xs">
                    <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700">
                        <i class="fa-solid fa-stamp text-blue-600"></i>
                        <span class="font-bold">Print Letterhead:</span>
                        <button type="button" role="switch" id="dash-switch-lh" onclick="window.toggleSettingSwitch('showLetterhead')"
                            class="toggle-track relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full bg-blue-600 p-0.5">
                            <span id="dash-thumb-lh" class="toggle-thumb inline-block h-4 w-4 rounded-full bg-white shadow translate-x-4"></span>
                        </button>
                    </div>

                    <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700">
                        <i class="fa-solid fa-building-columns text-emerald-600"></i>
                        <span class="font-bold">Invoice Bank Details:</span>
                        <button type="button" role="switch" id="dash-switch-bank" onclick="window.toggleSettingSwitch('showBank')"
                            class="toggle-track relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full bg-emerald-600 p-0.5">
                            <span id="dash-thumb-bank" class="toggle-thumb inline-block h-4 w-4 rounded-full bg-white shadow translate-x-4"></span>
                        </button>
                    </div>

                    <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700">
                        <i class="fa-solid fa-percent text-amber-500"></i>
                        <span class="font-bold">Default Tax (<span id="dash-tax-pct">18</span>%):</span>
                        <button type="button" role="switch" id="dash-switch-tax" onclick="window.toggleSettingSwitch('taxEnabled')"
                            class="toggle-track relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full bg-amber-500 p-0.5">
                            <span id="dash-thumb-tax" class="toggle-thumb inline-block h-4 w-4 rounded-full bg-white shadow translate-x-4"></span>
                        </button>
                    </div>

                    <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700">
                        <i class="fa-solid fa-eye-slash text-purple-600"></i>
                        <span class="font-bold">Hide Job Card Prices:</span>
                        <button type="button" role="switch" id="dash-switch-hideprice" onclick="window.toggleSettingSwitch('defaultHideJobPrices')"
                            class="toggle-track relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full bg-slate-400 p-0.5">
                            <span id="dash-thumb-hideprice" class="toggle-thumb inline-block h-4 w-4 rounded-full bg-white shadow translate-x-0"></span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- ALERTS GRID -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="bg-white dark:bg-slate-900 rounded-xl border border-blue-200 dark:border-blue-900 shadow-sm overflow-hidden">
                    <div class="p-3.5 bg-blue-50 dark:bg-blue-950/60 border-b border-blue-200 dark:border-blue-900 flex justify-between items-center">
                        <h3 class="font-bold text-blue-950 dark:text-blue-200 text-xs flex items-center gap-1.5">
                            <i class="fa-solid fa-bell text-blue-600"></i> Next Service Due Reminders (WhatsApp &amp; SMS)
                        </h3>
