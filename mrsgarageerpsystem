                            </div>
                        </div>
                        <div class="text-left sm:text-right text-xs text-slate-700 space-y-0.5">
                            <p class="font-bold text-slate-900">Tel: ${s.phone}</p>
                            ${s.email ? `<p>${s.email}</p>` : ''}
                            <p class="text-slate-600">${s.address}</p>
                            ${refBadge}
                        </div>
                    </div>
                `;
            }

            return `
                <div class="flex items-center gap-4">
                    ${logoHtml}
                    <div class="flex-1">
                        <h2 class="font-black text-xl tracking-wide text-navy-950">${s.name}</h2>
                        <p class="text-xs font-bold text-slate-700">${s.tagline}</p>
                        ${noteLine}
                        <p class="text-xs text-slate-600">${s.address}</p>
                        <p class="text-xs font-bold text-slate-800">Tel: ${s.phone} ${s.email ? ' | Email: ' + s.email : ''}</p>
                        ${regLine}
                        ${refBadge}
                    </div>
                </div>
            `;
        };

