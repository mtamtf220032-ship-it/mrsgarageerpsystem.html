            if (window.getEl('jc-warranty-months')) window.getEl('jc-warranty-months').value = job.warrantyMonths || '';
            if (window.getEl('jc-outsource-desc')) window.getEl('jc-outsource-desc').value = job.outsourceDesc || '';
            if (window.getEl('jc-outsource-cost')) window.getEl('jc-outsource-cost').value = job.outsourceCost || 0;
            if (window.getEl('jc-outsource-charge')) window.getEl('jc-outsource-charge').value = job.outsourceCharge || 0;
            window.getEl('jc-status').value = job.status;
