            const s = window.workshopSettings;
            if (window.getEl('header-workshop-name')) window.getEl('header-workshop-name').innerText = s.name || 'MRS GARAGE';
            if (window.getEl('header-workshop-tagline')) window.getEl('header-workshop-tagline').innerText = s.tagline || '';
            if (window.getEl('rep-ws-heading')) window.getEl('rep-ws-heading').innerText = `${s.name || 'MRS GARAGE'} - FINANCIAL & EXACT PROFIT SUMMARY`;

            const headerLogo = window.getEl('header-workshop-logo');
            const headerIcon = window.getEl('header-workshop-icon');
            const previewImg = window.getEl('set-logo-preview');
            const previewPh = window.getEl('set-logo-placeholder');

            if (s.logo) {
                if (headerLogo) { headerLogo.src = s.logo; headerLogo.classList.remove('hidden'); }
                if (headerIcon) headerIcon.classList.add('hidden');
                if (previewImg) { previewImg.src = s.logo; previewImg.classList.remove('hidden'); }
                if (previewPh) previewPh.classList.add('hidden');
            } else {
                if (headerLogo) headerLogo.classList.add('hidden');
                if (headerIcon) headerIcon.classList.remove('hidden');
                if (previewImg) previewImg.classList.add('hidden');
                if (previewPh) previewPh.classList.remove('hidden');
            }

            if (window.getEl('settings-letterhead-live-preview')) {
                window.getEl('settings-letterhead-live-preview').innerHTML = window.buildLetterheadHtml('PREVIEW-001');
            }
            window.applyLetterheadToDoc('inv');
            window.applyLetterheadToDoc('jcv');
            window.applyLetterheadToDoc('qp');
        };

        window.populateSettingsForm = function() {
            const s = window.workshopSettings;
            if (window.getEl('set-name')) window.getEl('set-name').value = s.name || '';
            if (window.getEl('set-reg-no')) window.getEl('set-reg-no').value = s.regNo || '';
            if (window.getEl('set-vat-no')) window.getEl('set-vat-no').value = s.vatNo || '';
            if (window.getEl('set-tagline')) window.getEl('set-tagline').value = s.tagline || '';
            if (window.getEl('set-address')) window.getEl('set-address').value = s.address || '';
            if (window.getEl('set-phone')) window.getEl('set-phone').value = s.phone || '';
            if (window.getEl('set-email')) window.getEl('set-email').value = s.email || '';
            if (window.getEl('set-header-note')) window.getEl('set-header-note').value = s.headerNote || '';
            if (window.getEl('set-tax-rate')) window.getEl('set-tax-rate').value = s.taxRate ?? 18;
            if (window.getEl('set-logo-size')) window.getEl('set-logo-size').value = s.logoSize || 64;
            if (window.getEl('set-logo-size-label')) window.getEl('set-logo-size-label').innerText = s.logoSize || 64;
            if (window.getEl('set-logo-align')) window.getEl('set-logo-align').value = s.logoAlign || 'left';
            if (window.getEl('set-app-password')) window.getEl('set-app-password').value = s.appPassword || '';
            if (window.getEl('set-admin-pin')) window.getEl('set-admin-pin').value = s.adminPin || '';
            if (window.getEl('set-rec-email')) window.getEl('set-rec-email').value = s.recoveryEmail || '';
            if (window.getEl('set-rec-phone')) window.getEl('set-rec-phone').value = s.recoveryPhone || '';
            window.updateHeaderBrandUI();
        };

        window.saveSettings = function(e) {
            e.preventDefault();
            window.workshopSettings.name = window.getEl('set-name').value.trim();
            window.workshopSettings.regNo = window.getEl('set-reg-no')?.value.trim().toUpperCase() || '';
            window.workshopSettings.vatNo = window.getEl('set-vat-no')?.value.trim().toUpperCase() || '';
            window.workshopSettings.tagline = window.getEl('set-tagline').value.trim();
            window.workshopSettings.address = window.getEl('set-address').value.trim();
            window.workshopSettings.phone = window.getEl('set-phone').value.trim();
            window.workshopSettings.email = window.getEl('set-email')?.value.trim() || '';
            window.workshopSettings.headerNote = window.getEl('set-header-note')?.value.trim() || '';
            window.workshopSettings.taxRate = parseFloat(window.getEl('set-tax-rate')?.value) || 0;
            window.workshopSettings.logoSize = parseInt(window.getEl('set-logo-size')?.value) || 64;
            window.workshopSettings.logoAlign = window.getEl('set-logo-align')?.value || 'left';
            saveState();
            window.syncAllSwitchesUI();
            window.updateHeaderBrandUI();
            window.refreshSystemData();
            window.showToast('Workshop letterhead & VAT settings saved!');
        };

        // --- BACKUP & RESTORE ---
        window.buildBackupPayload = function() {
            return {
                exportedAt: new Date().toISOString(),
                workshopSettings: window.workshopSettings,
                jobCards: window.jobCards,
                quotations: window.quotations,
                inventory: window.inventory,
                services: window.services,
                customers: window.customers,
                staff: window.staff,
                expenses: window.expenses,
                suppliers: window.suppliers,
                cashbookOpening: window.cashbookOpening,
                recycleBin: window.recycleBin
            };
        };

        window.downloadBackupJson = function() {
            const payload = JSON.stringify(window.buildBackupPayload(), null, 2);
            const blob = new Blob([payload], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `MRS_GARAGE_Backup_${TODAY_STR}.json`;
            a.click();
            URL.revokeObjectURL(url);
            window.showToast('Full backup JSON downloaded!');
        };

        window.quickGoogleDriveBackup = function() {
            window.downloadBackupJson();
        };

        window.uploadBackupJson = function(event) {
            const file = event.target.files?.[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = JSON.parse(e.target.result);
                    if (data.workshopSettings) window.workshopSettings = { ...window.workshopSettings, ...data.workshopSettings };
                    if (data.jobCards) window.jobCards = data.jobCards;
                    if (data.quotations) window.quotations = data.quotations;
                    if (data.inventory) window.inventory = data.inventory;
                    if (data.services) window.services = data.services;
                    if (data.customers) window.customers = data.customers;
                    if (data.staff) window.staff = data.staff;
                    if (data.expenses) window.expenses = data.expenses;
                    if (data.suppliers) window.suppliers = data.suppliers;
                    if (data.cashbookOpening) window.cashbookOpening = data.cashbookOpening;
                    if (data.recycleBin) window.recycleBin = data.recycleBin;
                    saveState();
                    window.syncAllSwitchesUI();
                    window.populateSettingsForm();
                    window.refreshSystemData();
                    window.showToast('All records restored from backup JSON!');
                } catch (err) {
                    window.showToast('Invalid JSON backup file!');
                }
            };
            reader.readAsText(file);
        };

        // --- GLOBAL REFRESH ---
        window.refreshSystemData = function() {
            window.updateDashboardStats();
            window.renderDashboardJobs();
            window.renderDashboardAlerts();
            window.renderJobCards();
            window.renderInvoices();
            window.renderQuotations();
            window.renderCashbook();
            window.renderFinancialReport();
            window.renderSuppliers();
            window.renderExpenses();
            window.renderInventory();
            window.renderServices();
            window.renderCustomers();
            window.renderStaff();
            window.renderRecycleBin();
        };

        // --- INITIALIZE APP ---
        window.addEventListener('DOMContentLoaded', () => {
            loadState();
            window.syncAllSwitchesUI();
            window.renderSecurityGate();
            window.populateSettingsForm();
            window.refreshSystemData();
        });
    </script>
</body>
</html>
