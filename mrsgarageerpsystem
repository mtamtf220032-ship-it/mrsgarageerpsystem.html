        window.convertQuoteToJobCard = function (quoteId) {
            const quotes = loadDB(KEYS.QUOTES, []);
            const q = quotes.find(x => x.id === quoteId);
            if (!q) return;

            const jobs = loadDB(KEYS.JOBS, []);
            const count = jobs.length + 1001;
            const newJob = {
                ...q,
                id: 'JOB-' + Date.now(),
                jobNo: 'JC-' + count,
                invoiceNo: 'INV-' + count,
                date: new Date().toISOString().split('T')[0],
                status: 'In Progress',
                paidAmount: 0,
                balanceDue: q.grandTotal,
                paymentStatus: 'Pending'
            };
            jobs.unshift(newJob);
            saveDB(KEYS.JOBS, jobs);

            q.status = 'Converted';
            saveDB(KEYS.QUOTES, quotes);

            closeModal('printPreviewModal');
            window.switchTab('jobcards');
            showToast(`Converted ${q.quoteNo} to Job Card ${newJob.jobNo}!`);
        };

        function buildShareMessage(type, doc) {
            const s = getSettings();
            const docNo = type === 'quote' ? doc.quoteNo : (type === 'invoice' ? doc.invoiceNo : doc.jobNo);
            const hidePrices = (type === 'job' && Boolean(doc.hidePrices));
            let msg = `*${s.name}*\n${type.toUpperCase()}: *${docNo}*\nDate: ${doc.date}\nCustomer: ${doc.customerName}\nVehicle: *${doc.vehicleNo}* (${doc.vehicleModel || ''})\n`;
            if (doc.vin) msg += `VIN: ${doc.vin}\n`;
            if (!hidePrices) {
                msg += `Total Amount: *${fmtMoney(doc.grandTotal)}*\n`;
                if (type !== 'quote') msg += `Paid: ${fmtMoney(doc.paidAmount || 0)} | Balance Due: *${fmtMoney(doc.balanceDue || 0)}*\n`;
            }
            if (doc.remarks) msg += `Notes: ${doc.remarks}\n`;
            msg += `Contact: ${s.phone}`;
            return msg;
        }

        function formatWaPhone(phone) {
            const digits = (phone || '').replace(/\D/g, '');
            if (!digits) return '';
            return digits.startsWith('0') ? '94' + digits.slice(1) : digits;
        }

        window.shareDocumentWhatsApp = function (type, id) {
            const doc = type === 'quote' ? loadDB(KEYS.QUOTES, []).find(q => q.id === id) : loadDB(KEYS.JOBS, []).find(j => j.id === id);
            if (!doc) return;
            const phone = formatWaPhone(doc.customerPhone);
            const text = encodeURIComponent(buildShareMessage(type, doc));
            window.open(`https://wa.me/${phone}?text=${text}`, '_blank');
        };

        window.shareDocumentSMS = function (type, id) {
            const doc = type === 'quote' ? loadDB(KEYS.QUOTES, []).find(q => q.id === id) : loadDB(KEYS.JOBS, []).find(j => j.id === id);
            if (!doc) return;
            const text = encodeURIComponent(buildShareMessage(type, doc));
            window.location.href = `sms:${doc.customerPhone || ''}?body=${text}`;
        };

