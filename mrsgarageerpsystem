                    return decoded;
                } catch (e) {}
            }
            const savedCustom = localStorage.getItem('mrs_custom_firebase_cfg');
            if (savedCustom) {
                try { return JSON.parse(savedCustom); } catch (e) {}
            }
            if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                try { return JSON.parse(__firebase_config); } catch (e) {}
            }
            return DEFAULT_FIREBASE_CONFIG;
        }

        window.pushStateToCloud = async function() {
            if (!cloudDb || !cloudUser || isApplyingRemote) return;
            try {
                const appId = typeof __app_id !== 'undefined' ? __app_id : 'mrs-garage-app';
                const roomCode = getActiveRoomCode();
                const roomRef = doc(cloudDb, 'artifacts', appId, 'public', 'data', 'workshop_rooms', roomCode);
                await setDoc(roomRef, {
                    updatedAt: Date.now(),
                    workshopSettings: JSON.stringify(window.workshopSettings || {}),
                    jobCards: JSON.stringify(window.jobCards || []),
                    quotations: JSON.stringify(window.quotations || []),
                    inventory: JSON.stringify(window.inventory || []),
                    services: JSON.stringify(window.services || []),
                    customers: JSON.stringify(window.customers || []),
                    staff: JSON.stringify(window.staff || []),
                    expenses: JSON.stringify(window.expenses || []),
                    suppliers: JSON.stringify(window.suppliers || []),
                    cashbookOpening: JSON.stringify(window.cashbookOpening || {}),
                    recycleBin: JSON.stringify(window.recycleBin || [])
                }, { merge: true });
            } catch (err) {
                console.warn('Cloud push skipped:', err.message);
            }
        };

        window.initLiveCloudSync = async function() {
            const roomCode = getActiveRoomCode();
            const cfg = getActiveFirebaseConfig();
            if (window.getEl('set-workshop-sync-code')) window.getEl('set-workshop-sync-code').value = roomCode;
            if (cfg && window.getEl('set-firebase-config-json')) window.getEl('set-firebase-config-json').value = JSON.stringify(cfg);

            if (!cfg || !cfg.apiKey) {
                setLiveSyncStatus(false, 'Local Mode');
                return;
            }

            try {
                setLiveSyncStatus(false, 'Connecting...');
                if (unsubscribeSnapshot) { unsubscribeSnapshot(); unsubscribeSnapshot = null; }
                for (const existingApp of getApps()) { await deleteApp(existingApp); }

                const app = initializeApp(cfg);
                const auth = getAuth(app);
                cloudDb = getFirestore(app);

                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    const cred = await signInWithCustomToken(auth, __initial_auth_token);
                    cloudUser = cred.user;
                } else {
                    const cred = await signInAnonymously(auth);
                    cloudUser = cred.user;
                }

                if (!cloudUser) return;

                const appId = typeof __app_id !== 'undefined' ? __app_id : 'mrs-garage-app';
                const roomRef = doc(cloudDb, 'artifacts', appId, 'public', 'data', 'workshop_rooms', roomCode);

                unsubscribeSnapshot = onSnapshot(roomRef, (snap) => {
                    setLiveSyncStatus(true, `Live: ${roomCode}`);
                    if (!snap.exists()) {
                        window.pushStateToCloud();
                        return;
                    }
                    const d = snap.data();
                    isApplyingRemote = true;
                    try {
                        if (d.workshopSettings) window.workshopSettings = { ...window.workshopSettings, ...JSON.parse(d.workshopSettings) };
                        if (d.jobCards) window.jobCards = JSON.parse(d.jobCards);
                        if (d.quotations) window.quotations = JSON.parse(d.quotations);
                        if (d.inventory) window.inventory = JSON.parse(d.inventory);
                        if (d.services) window.services = JSON.parse(d.services);
                        if (d.customers) window.customers = JSON.parse(d.customers);
                        if (d.staff) window.staff = JSON.parse(d.staff);
                        if (d.expenses) window.expenses = JSON.parse(d.expenses);
                        if (d.suppliers) window.suppliers = JSON.parse(d.suppliers);
                        if (d.cashbookOpening) window.cashbookOpening = JSON.parse(d.cashbookOpening);
                        if (d.recycleBin) window.recycleBin = JSON.parse(d.recycleBin);

                        window.saveStateLocalOnly();
                        window.populateSettingsForm();
                        window.refreshSystemData();
                        window.renderSecurityGate();
                    } finally {
                        isApplyingRemote = false;
                    }
                }, () => setLiveSyncStatus(false, 'Sync Error'));
            } catch (e) {
                setLiveSyncStatus(false, 'Local Mode');
            }
        };

        window.updateWorkshopSyncCode = function() {
            const code = (window.getEl('set-workshop-sync-code')?.value || '').trim().toUpperCase();
            if (!code) return window.showToast('Enter a valid Room Code!');
            localStorage.setItem('mrs_sync_room_code', code);
            window.initLiveCloudSync();
            window.showToast(`Connected to Sync Room: ${code}`);
        };

        window.saveCustomFirebaseConfig = function() {
            const raw = (window.getEl('set-firebase-config-json')?.value || '').trim();
            if (!raw) return window.showToast('Paste your Firebase Config JSON first!');
            try {
                const parsed = JSON.parse(raw);
                if (!parsed.apiKey || !parsed.projectId) throw new Error('Invalid');
                localStorage.setItem('mrs_custom_firebase_cfg', JSON.stringify(parsed));
                window.initLiveCloudSync();
                window.showToast('Cloud DB Connected! Live Sync Active.');
            } catch (e) {
                window.showToast('Invalid Firebase Config JSON!');
            }
        };

        window.copyPhoneSyncLink = function() {
            const roomCode = getActiveRoomCode();
            const cfg = getActiveFirebaseConfig();
            const baseUrl = window.location.href.split('?')[0];
            const shareUrl = cfg
                ? `${baseUrl}?room=${encodeURIComponent(roomCode)}&cfg=${encodeURIComponent(btoa(JSON.stringify(cfg)))}`
                : `${baseUrl}?room=${encodeURIComponent(roomCode)}`;
            const dummy = document.createElement('textarea');
            dummy.value = shareUrl;
            document.body.appendChild(dummy);
            dummy.select();
            document.execCommand('copy');
            document.body.removeChild(dummy);
            window.showToast('Live Cloud Sync Link copied! Open it on another phone/PC.');
        };

        window.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => window.initLiveCloudSync(), 300);
        });
    </script>

