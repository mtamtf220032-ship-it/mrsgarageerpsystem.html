        // --- VEHICLE AUTO-FILL & HISTORY TIMELINE ---
        window.getAllKnownVehicles = function() {
            const map = new Map();
            const normalize = (str) => (str || '').replace(/[\s-]/g, '').toUpperCase();
            (window.customers || []).forEach(c => {
                const key = normalize(c.vehNo);
                if (key) map.set(key, { vehNo: c.vehNo.toUpperCase(), name: c.name || '', phone: c.phone || '', vehModel: c.vehModel || '', engineNo: c.engineNo || '', chassisNo: c.chassisNo || '' });
            });
            (window.jobCards || []).forEach(j => {
                const key = normalize(j.vehNo);
                if (key && !map.has(key)) map.set(key, { vehNo: j.vehNo.toUpperCase(), name: j.custName || '', phone: j.custPhone || '', vehModel: j.vehModel || '', engineNo: j.engineNo || '', chassisNo: j.chassisNo || '' });
            });
            return Array.from(map.values());
        };

        window.showVehicleSearchDropdown = function(inputEl, prefix) {
            const resultsBox = window.getEl(`${prefix}-veh-search-results`);
            if (!resultsBox) return;
            const query = (inputEl.value || '').trim().toUpperCase();
            const cleanQ = query.replace(/[\s-]/g, '');
            const matches = window.getAllKnownVehicles().filter(v => v.vehNo.includes(query) || v.vehNo.replace(/[\s-]/g, '').includes(cleanQ) || v.name.toUpperCase().includes(query));
            resultsBox.innerHTML = '';
            if (!matches.length) { resultsBox.classList.add('hidden'); return; }
            matches.forEach(v => {
                const div = document.createElement('div');
                div.className = 'p-2.5 hover:bg-amber-50 dark:hover:bg-slate-800 cursor-pointer flex justify-between items-center text-xs';
                div.innerHTML = `<div><span class="font-black text-navy-950 dark:text-white uppercase">${v.vehNo}</span> <span class="text-slate-500">(${v.vehModel || 'Vehicle'})</span><div class="text-[10px] text-slate-500">${v.name} &bull; ${v.phone}</div></div><span class="text-[10px] font-bold text-amber-600">Select</span>`;
                div.onclick = () => {
                    inputEl.value = v.vehNo;
                    window.autoFillByVehicleNo(v.vehNo, prefix);
                    resultsBox.classList.add('hidden');
                };
                resultsBox.appendChild(div);
            });
            resultsBox.classList.remove('hidden');
        };

        window.autoFillByVehicleNo = function(rawVehNo, prefix) {
            if (!rawVehNo) return;
            const cleanQuery = rawVehNo.replace(/[\s-]/g, '').toUpperCase();
            const normalize = (str) => (str || '').replace(/[\s-]/g, '').toUpperCase();

            if (prefix === 'jc') {
                const pastJobs = window.jobCards.filter(j => normalize(j.vehNo) === cleanQuery);
                const histBtn = window.getEl('jc-history-btn');
                if (histBtn) {
                    if (pastJobs.length > 0) histBtn.classList.remove('hidden');
                    else histBtn.classList.add('hidden');
                }
            }

            if (cleanQuery.length < 3) return;
            let match = (window.customers || []).find(c => normalize(c.vehNo) === cleanQuery);
            if (!match) {
                const pastJob = [...window.jobCards].reverse().find(j => normalize(j.vehNo) === cleanQuery);
                if (pastJob) match = { name: pastJob.custName, phone: pastJob.custPhone, vehModel: pastJob.vehModel, engineNo: pastJob.engineNo || '', chassisNo: pastJob.chassisNo || '' };
            }
            if (match) {
                if (prefix === 'jc') {
                    window.getEl('jc-cust-name').value = match.name || '';
                    window.getEl('jc-cust-phone').value = match.phone || '';
                    if (match.vehModel) window.getEl('jc-veh-model').value = match.vehModel;
                    if (match.engineNo) window.getEl('jc-engine-no').value = match.engineNo;
                    if (match.chassisNo) window.getEl('jc-chassis-no').value = match.chassisNo;
                } else if (prefix === 'quo') {
                    window.getEl('quo-cust-name').value = match.name || '';
                    window.getEl('quo-cust-phone').value = match.phone || '';
