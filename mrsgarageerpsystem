        function readDocSectionItems(section) {
            const rows = document.querySelectorAll(`#doc-${section}-tbody tr`);
            const items = [];
            rows.forEach(tr => {
                const name = tr.querySelector('.row-name').value.trim();
                const qty = parseFloat(tr.querySelector('.row-qty').value) || 0;
                const price = parseFloat(tr.querySelector('.row-price').value) || 0;
                const total = Math.round(qty * price * 100) / 100;
                tr.querySelector('.row-total').textContent = total.toLocaleString('en-US', { minimumFractionDigits: 2 });
                if (name) items.push({ name, qty, price, total });
            });
            return items;
        }

        window.recalculateDocTotals = function () {
            const s = getSettings();
            const type = document.getElementById('doc-type').value;
            const hidePrices = (type === 'job' && document.getElementById('doc-hide-prices-switch').checked);

            document.querySelectorAll('.doc-price-col').forEach(el => el.classList.toggle('hidden', hidePrices));
            document.getElementById('doc-totals-panel').classList.toggle('hidden', hidePrices);

            const parts = readDocSectionItems('parts');
            const labor = readDocSectionItems('labor');
            const rawMaterials = readDocSectionItems('rawMaterials');

            const subtotal = [...parts, ...labor, ...rawMaterials].reduce((acc, x) => acc + x.total, 0);
            const discount = parseFloat(document.getElementById('doc-discount').value) || 0;
            const afterDisc = Math.max(0, subtotal - discount);
            const vatOn = document.getElementById('doc-vat-switch').checked;
            const vatRate = parseFloat(s.taxRate) || 18;
            const vatAmount = vatOn ? Math.round(afterDisc * (vatRate / 100) * 100) / 100 : 0;
            const grandTotal = Math.round((afterDisc + vatAmount) * 100) / 100;
            const paidAmount = parseFloat(document.getElementById('doc-paid-amount').value) || 0;
            const balanceDue = Math.max(0, Math.round((grandTotal - paidAmount) * 100) / 100);

            document.getElementById('doc-vat-row').classList.toggle('hidden', !vatOn);
            document.getElementById('doc-subtotal-display').textContent = fmtMoney(subtotal);
            document.getElementById('doc-vat-display').textContent = fmtMoney(vatAmount);
            document.getElementById('doc-grandtotal-display').textContent = fmtMoney(grandTotal);
            document.getElementById('doc-balance-display').textContent = fmtMoney(balanceDue);

            return { parts, labor, rawMaterials, subtotal, discount, vatOn, vatRate, vatAmount, grandTotal, paidAmount, balanceDue, hidePrices };
        };

        /* AUTO-SAVE NEW PARTS, LABOR & RAW MATERIALS TO DATABASES */
        function autoSyncCatalogsFromDoc(parts, labor, rawMaterials) {
            let addedCount = 0;

            const inv = loadDB(KEYS.INVENTORY, []);
            parts.forEach(p => {
                if (!inv.some(x => x.name.toLowerCase() === p.name.toLowerCase())) {
                    inv.unshift({
                        id: 'PRT-' + Date.now() + '-' + Math.floor(Math.random() * 99),
                        code: 'PRT-' + (inv.length + 101),
                        name: p.name,
                        stock: 10,
                        buyPrice: Math.round(p.price * 0.75),
                        sellPrice: p.price
                    });
                    addedCount++;
                }
            });
            saveDB(KEYS.INVENTORY, inv);

            const srv = loadDB(KEYS.SERVICES, []);
            labor.forEach(l => {
                if (!srv.some(x => x.name.toLowerCase() === l.name.toLowerCase())) {
                    srv.unshift({
                        id: 'SRV-' + Date.now() + '-' + Math.floor(Math.random() * 99),
                        code: 'SVC-' + (srv.length + 301),
                        name: l.name,
                        rate: l.price
                    });
                    addedCount++;
                }
            });
            saveDB(KEYS.SERVICES, srv);

            const raw = loadDB(KEYS.RAWMATERIALS, []);
            rawMaterials.forEach(r => {
                if (!raw.some(x => x.name.toLowerCase() === r.name.toLowerCase())) {
                    raw.unshift({
                        id: 'RAW-' + Date.now() + '-' + Math.floor(Math.random() * 99),
                        code: 'RAW-' + (raw.length + 201),
                        name: r.name,
                        stock: 10,
                        rate: r.price
                    });
                    addedCount++;
                }
            });
            saveDB(KEYS.RAWMATERIALS, raw);

            if (addedCount > 0) {
                showToast(`Saved + Auto-added ${addedCount} new item(s) to Workshop DB!`);
            }
        }

        window.saveDocument = function (openPreviewAfter = false) {
            const type = document.getElementById('doc-type').value;
            const editId = document.getElementById('doc-edit-id').value;
            const vehicleNo = document.getElementById('doc-vehicle-no').value.toUpperCase().trim();
            const customerName = document.getElementById('doc-customer-name').value.trim();

            if (!vehicleNo || !customerName) {
                showToast('Please enter Vehicle Reg No and Customer Name!');
                return;
            }

            const t = window.recalculateDocTotals();
            autoSyncCatalogsFromDoc(t.parts, t.labor, t.rawMaterials);

            const docNo = document.getElementById('doc-number').value.toUpperCase().trim();
            const paymentStatus = t.grandTotal === 0 ? 'Paid' : (t.balanceDue <= 0 ? 'Paid' : (t.paidAmount > 0 ? 'Partial' : 'Pending'));
            const id = editId || ((type === 'quote' ? 'QT-' : 'JOB-') + Date.now());

            const docObj = {
                id,
                jobNo: type === 'quote' ? '' : docNo,
                invoiceNo: type === 'invoice' ? docNo : docNo.replace('JC', 'INV'),
                quoteNo: type === 'quote' ? docNo : '',
                date: document.getElementById('doc-date').value,
                status: document.getElementById('doc-status').value,
                technician: document.getElementById('doc-technician').value.trim(),
                vehicleNo,
                vehicleModel: document.getElementById('doc-vehicle-model').value.trim(),
                vin: document.getElementById('doc-vin').value.toUpperCase().trim(),
                chassis: document.getElementById('doc-chassis').value.toUpperCase().trim(),
                customerName,
                customerPhone: document.getElementById('doc-customer-phone').value.trim(),
                customerAddress: document.getElementById('doc-customer-address').value.trim(),
                mileage: document.getElementById('doc-mileage').value.trim(),
                nextMileage: document.getElementById('doc-next-mileage').value.trim(),
                insurance: document.getElementById('doc-insurance').value,
                claimNo: document.getElementById('doc-claim-no').value.trim(),
                policyNo: document.getElementById('doc-policy-no').value.trim(),
                assessor: document.getElementById('doc-assessor').value.trim(),
                parts: t.parts,
                labor: t.labor,
                rawMaterials: t.rawMaterials,
                remarks: document.getElementById('doc-remarks').value.trim(),
                terms: document.getElementById('doc-terms').value.trim(),
                includeVat: t.vatOn,
                hidePrices: t.hidePrices,
                vatRate: t.vatRate,
                vatAmount: t.vatAmount,
                subtotal: t.subtotal,
                discount: t.discount,
                grandTotal: t.grandTotal,
                paidAmount: t.paidAmount,
                balanceDue: t.balanceDue,
                paymentStatus
            };

            if (type === 'quote') {
                const quotes = loadDB(KEYS.QUOTES, []);
                const idx = quotes.findIndex(q => q.id === id);
                if (idx >= 0) quotes[idx] = docObj; else quotes.unshift(docObj);
                saveDB(KEYS.QUOTES, quotes);
            } else {
                const jobs = loadDB(KEYS.JOBS, []);
                const idx = jobs.findIndex(j => j.id === id);
                if (idx >= 0) jobs[idx] = { ...jobs[idx], ...docObj }; else jobs.unshift(docObj);
                saveDB(KEYS.JOBS, jobs);
            }

            // Auto-register / update Vehicle & Customer in mrs_customers
            const custs = loadDB(KEYS.CUSTOMERS, []);
            const cIdx = custs.findIndex(c => (c.vehicleNo || '').toUpperCase().trim() === vehicleNo);
            const custPayload = {
                id: cIdx >= 0 ? custs[cIdx].id : 'CUST-' + Date.now(),
                vehicleNo,
                vehicleModel: docObj.vehicleModel,
                vin: docObj.vin,
                chassis: docObj.chassis,
                name: docObj.customerName,
                phone: docObj.customerPhone,
                address: docObj.customerAddress,
                insurance: docObj.insurance,
                policyNo: docObj.policyNo
            };
            if (cIdx >= 0) custs[cIdx] = { ...custs[cIdx], ...custPayload }; else custs.unshift(custPayload);
            saveDB(KEYS.CUSTOMERS, custs);

            closeModal('docEditorModal');
            refreshAllUI();
            showToast('Document saved successfully!');
            if (openPreviewAfter) {
                window.openPrintPreview(type, id);
            }
