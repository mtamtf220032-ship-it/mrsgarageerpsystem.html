        window.syncCustomerFromRecord = function(data) {
            if (!data || !data.vehNo) return;
            const normVeh = data.vehNo.replace(/[\s-]/g, '').toUpperCase();
            const existing = window.customers.find(c => (c.vehNo || '').replace(/[\s-]/g, '').toUpperCase() === normVeh);
            if (existing) {
                if (data.custName) existing.name = data.custName;
                if (data.custPhone) existing.phone = data.custPhone;
                if (data.vehModel) existing.vehModel = data.vehModel;
                if (data.engineNo) existing.engineNo = data.engineNo;
                if (data.chassisNo) existing.chassisNo = data.chassisNo;
            } else {
                window.customers.push({
                    id: `CUST-${Math.floor(1000 + Math.random() * 9000)}`,
                    name: data.custName || 'Walk-in Customer',
                    phone: data.custPhone || '',
                    address: '',
                    vehNo: data.vehNo.toUpperCase(),
                    vehModel: data.vehModel || '',
                    engineNo: data.engineNo || '',
                    chassisNo: data.chassisNo || ''
                });
            }
        };

        // --- SEARCHABLE LINE ITEMS (PARTS & LABOR) ---
        window.createSearchableRow = function(category, calcCallback, descVal = '', qtyVal = 1, priceVal = '') {
            const row = document.createElement('div');
            row.className = 'relative bg-slate-50 dark:bg-slate-800/70 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2 item-row';
            row.dataset.category = category;
            const isPart = category === 'Part';
            const searchPlaceholder = isPart ? 'Search Spare Parts DB or type new part...' : 'Search Labor & Services DB or type new service...';

            row.innerHTML = `
                <div class="relative">
                    <input type="text" class="row-search-input w-full p-2 border border-slate-300 dark:border-slate-700 rounded-lg text-xs bg-white dark:bg-slate-900 focus:ring-2 focus:ring-amber-400 outline-none" placeholder="${searchPlaceholder}">
                    <div class="row-search-results hidden absolute left-0 right-0 top-full mt-1 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl shadow-2xl z-30 max-h-56 overflow-y-auto divide-y divide-slate-100"></div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 items-center">
                    <input type="text" class="row-desc sm:col-span-6 p-2 border border-slate-300 dark:border-slate-700 rounded-lg text-xs font-medium bg-white dark:bg-slate-900" placeholder="${isPart ? 'Part description' : 'Labor description'}" value="${descVal}">
                    <div class="grid grid-cols-12 sm:col-span-6 gap-2 items-center">
                        <input type="number" class="row-qty col-span-4 p-2 border border-slate-300 dark:border-slate-700 rounded-lg text-xs text-center font-mono bg-white dark:bg-slate-900" value="${qtyVal}" min="0.1" step="0.1" placeholder="Qty">
                        <input type="number" class="row-price col-span-6 p-2 border border-slate-300 dark:border-slate-700 rounded-lg text-xs text-right font-mono bg-white dark:bg-slate-900" placeholder="Unit Price" value="${priceVal}" min="0" step="0.01">
                        <button type="button" class="row-remove col-span-2 text-red-500 hover:text-red-700 text-center p-2"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
            `;

            const searchInput = row.querySelector('.row-search-input');
            const resultsBox = row.querySelector('.row-search-results');
            const descInput = row.querySelector('.row-desc');
            const qtyInput = row.querySelector('.row-qty');
            const priceInput = row.querySelector('.row-price');
            const removeBtn = row.querySelector('.row-remove');

            const renderMatches = (queryText) => {
                const q = (queryText || '').trim().toLowerCase();
                const sourceList = isPart ? window.inventory : window.services;
                const matches = sourceList.filter(item => item.name.toLowerCase().includes(q) || (item.code && item.code.toLowerCase().includes(q)));

                resultsBox.innerHTML = '';
                matches.forEach(item => {
                    const price = isPart ? item.price : item.rate;
                    const stockTag = isPart ? `<span class="text-[10px] ml-1 px-1.5 py-0.5 rounded ${item.qty < 5 ? 'bg-red-100 text-red-700 font-bold' : 'bg-slate-100 text-slate-600'}">Stock: ${item.qty}</span>` : '';
                    const div = document.createElement('div');
                    div.className = 'p-2.5 hover:bg-amber-50 dark:hover:bg-slate-800 cursor-pointer flex justify-between items-center text-xs';
                    div.innerHTML = `<div><span class="font-mono text-[10px] font-bold text-slate-500 mr-1">[${item.code || 'DB'}]</span><span class="font-bold text-navy-950 dark:text-white">${item.name}</span>${stockTag}</div><span class="font-mono font-bold text-emerald-700 dark:text-emerald-400 whitespace-nowrap ml-2">LKR ${Number(price).toLocaleString()}</span>`;
                    div.onclick = () => {
                        descInput.value = item.name;
                        priceInput.value = price;
                        searchInput.value = '';
                        resultsBox.classList.add('hidden');
                        calcCallback();
                    };
                    resultsBox.appendChild(div);
                });

                if (q.length > 0 && matches.length === 0) {
                    const addDiv = document.createElement('div');
                    addDiv.className = 'p-2.5 bg-blue-50 hover:bg-blue-100 cursor-pointer flex justify-between items-center text-xs font-bold text-blue-800';
                    addDiv.innerHTML = `<span>+ Save "${queryText}" to ${isPart ? 'Spare Parts' : 'Services'} DB</span><span class="text-[10px] underline">Add Now</span>`;
                    addDiv.onclick = () => {
                        const unitRate = parseFloat(priceInput.value) || 0;
                        if (isPart) window.inventory.push({ id: `PRT-${Date.now()}`, code: `PRT-${Math.floor(100 + Math.random() * 900)}`, name: queryText, qty: 10, cost: 0, price: unitRate });
                        else window.services.push({ id: `SRV-${Date.now()}`, code: `SRV-${Math.floor(100 + Math.random() * 900)}`, name: queryText, rate: unitRate });
                        saveState();
                        descInput.value = queryText;
                        searchInput.value = '';
                        resultsBox.classList.add('hidden');
                        window.showToast(`Saved "${queryText}" to database!`);
                        calcCallback();
                    };
                    resultsBox.appendChild(addDiv);
                }
                resultsBox.classList.remove('hidden');
            };

            searchInput.addEventListener('focus', () => renderMatches(searchInput.value));
            searchInput.addEventListener('input', () => renderMatches(searchInput.value));
            document.addEventListener('click', (ev) => { if (!row.contains(ev.target)) resultsBox.classList.add('hidden'); });
            qtyInput.addEventListener('input', calcCallback);
            priceInput.addEventListener('input', calcCallback);
            removeBtn.addEventListener('click', () => { row.remove(); calcCallback(); });
            return row;
        };

        window.addJobPartRow = (desc = '', qty = 1, price = '') => { const c = window.getEl('jc-parts-container'); if (c) c.appendChild(window.createSearchableRow('Part', window.calculateJobSubtotal, desc, qty, price)); };
        window.addJobLaborRow = (desc = '', qty = 1, price = '') => { const c = window.getEl('jc-labor-container'); if (c) c.appendChild(window.createSearchableRow('Labor', window.calculateJobSubtotal, desc, qty, price)); };

        // --- JOB CARDS CRUD ---
        window.saveJobCard = function(e) {
            e.preventDefault();
            const existingId = window.getEl('jc-id').value;
            const id = existingId || `JOB-${Math.floor(1000 + Math.random() * 9000)}`;
            const date = window.getEl('jc-date').value;
            const custName = window.getEl('jc-cust-name').value;
            const custPhone = window.getEl('jc-cust-phone').value;
            const vehNo = window.getEl('jc-veh-no').value.toUpperCase();
            const vehModel = window.getEl('jc-veh-model').value;
            const engineNo = window.getEl('jc-engine-no').value;
            const chassisNo = window.getEl('jc-chassis-no')?.value || '';
            const odometer = window.getEl('jc-odometer').value;
            const mechanic = window.getEl('jc-mechanic').value;
            const nextServiceDate = window.getEl('jc-next-service-date')?.value || '';
            const nextServiceKm = window.getEl('jc-next-service-km')?.value || '';
            const warrantyNote = window.getEl('jc-warranty-note')?.value || '';
            const warrantyMonths = parseInt(window.getEl('jc-warranty-months')?.value) || 0;
            const outsourceDesc = window.getEl('jc-outsource-desc')?.value || '';
            const outsourceCost = parseFloat(window.getEl('jc-outsource-cost')?.value) || 0;
            const outsourceCharge = parseFloat(window.getEl('jc-outsource-charge')?.value) || 0;
            const status = window.getEl('jc-status').value;
            const payment = window.getEl('jc-payment').value;
            const discount = parseFloat(window.getEl('jc-discount').value) || 0;
            const advance = parseFloat(window.getEl('jc-advance')?.value) || 0;
            const notes = window.getEl('jc-notes')?.value || '';
            const terms = window.getEl('jc-terms').value || DEFAULT_INVOICE_TERMS;

            const items = [];
            document.querySelectorAll('#jc-parts-container .item-row').forEach(row => {
                const desc = row.querySelector('.row-desc').value.trim();
                const qty = parseFloat(row.querySelector('.row-qty').value) || 0;
                const price = parseFloat(row.querySelector('.row-price').value) || 0;
                if (desc) items.push({ category: 'Part', desc, qty, price });
            });
            document.querySelectorAll('#jc-labor-container .item-row').forEach(row => {
                const desc = row.querySelector('.row-desc').value.trim();
                const qty = parseFloat(row.querySelector('.row-qty').value) || 0;
                const price = parseFloat(row.querySelector('.row-price').value) || 0;
                if (desc) items.push({ category: 'Labor', desc, qty, price });
            });

            if (!existingId) {
                items.filter(i => i.category === 'Part').forEach(usedPart => {
                    const invMatch = window.inventory.find(inv => inv.name.toLowerCase() === usedPart.desc.toLowerCase());
                    if (invMatch) invMatch.qty = Math.max(0, (parseInt(invMatch.qty) || 0) - usedPart.qty);
                });
            }

            const existingIndex = window.jobCards.findIndex(j => j.id === id);
            const prevNotify = existingIndex >= 0 ? window.jobCards[existingIndex].notifyCustomer : window.workshopSettings.autoNotify;
            const jobObj = { id, date, custName, custPhone, vehNo, vehModel, engineNo, chassisNo, odometer, mechanic, nextServiceDate, nextServiceKm, warrantyNote, warrantyMonths, outsourceDesc, outsourceCost, outsourceCharge, status, payment, discount, advance, notifyCustomer: prevNotify, notes, terms, items };

            if (existingIndex >= 0) window.jobCards[existingIndex] = jobObj;
            else window.jobCards.push(jobObj);

            window.syncCustomerFromRecord({ custName, custPhone, vehNo, vehModel, engineNo, chassisNo });
            saveState();
            window.closeModal('jobCardModal');
            window.refreshSystemData();
            window.showToast(`Job Card ${id} saved & stock updated!`);
        };

