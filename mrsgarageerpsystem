        window.buildLetterheadHtml = function(docCode = '') {
            const s = window.workshopSettings;
            const logoSize = parseInt(s.logoSize) || 64;
            const align = s.logoAlign || 'left';
            const showQr = s.showQrBadge !== false;

            const logoHtml = s.logo
                ? `<img src="${s.logo}" alt="${s.name}" style="height:${logoSize}px; max-width:200px;" class="object-contain rounded-lg shrink-0">`
                : `<div style="height:${logoSize}px; width:${logoSize}px;" class="rounded-xl bg-amber-500 text-navy-950 flex items-center justify-center font-black text-2xl shrink-0"><i class="fa-solid fa-wrench"></i></div>`;

            const regBadges = [];
            if (s.regNo) regBadges.push(`Reg No: ${s.regNo}`);
            if (s.vatNo) regBadges.push(`VAT Reg: ${s.vatNo}`);
            const regLine = regBadges.length ? `<p class="text-[11px] font-mono font-bold text-slate-700">${regBadges.join('  |  ')}</p>` : '';
            const noteLine = s.headerNote ? `<p class="text-[11px] font-bold text-amber-700">${s.headerNote}</p>` : '';
            const refBadge = showQr && docCode
                ? `<div class="inline-flex items-center gap-1.5 px-2 py-1 border border-slate-300 rounded bg-slate-50 text-[10px] font-mono text-slate-700 mt-1"><i class="fa-solid fa-qrcode text-navy-950"></i> VERIFIED REF: ${docCode}</div>`
                : '';

            if (align === 'center') {
                return `
                    <div class="flex flex-col items-center text-center gap-1.5">
                        ${logoHtml}
                        <h2 class="font-black text-xl tracking-wide text-navy-950">${s.name}</h2>
                        <p class="text-xs font-bold text-slate-700">${s.tagline}</p>
                        ${noteLine}
                        <p class="text-xs text-slate-600">${s.address}</p>
                        <p class="text-xs font-bold text-slate-800">Tel: ${s.phone} ${s.email ? ' | Email: ' + s.email : ''}</p>
                        ${regLine}
                        ${refBadge}
                    </div>
                `;
            }

            if (align === 'split') {
                return `
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3.5">
                            ${logoHtml}
                            <div>
                                <h2 class="font-black text-xl tracking-wide text-navy-950">${s.name}</h2>
                                <p class="text-xs font-bold text-slate-700">${s.tagline}</p>
                                ${noteLine}
