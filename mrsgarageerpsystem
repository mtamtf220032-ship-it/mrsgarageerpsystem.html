        // --- CALCULATIONS (WITH TAX SWITCH SUPPORT) ---
        window.getJobSubtotalBeforeTax = function(job) {
            const itemsSub = (job.items || []).reduce((acc, it) => acc + ((parseFloat(it.qty) || 0) * (parseFloat(it.price) || 0)), 0);
            const outsourceCharge = parseFloat(job.outsourceCharge) || 0;
            const disc = parseFloat(job.discount) || 0;
            return Math.max(0, itemsSub + outsourceCharge - disc);
        };

        window.getJobTaxAmount = function(job) {
            if (!window.workshopSettings.taxEnabled) return 0;
            const sub = window.getJobSubtotalBeforeTax(job);
            const rate = parseFloat(window.workshopSettings.taxRate) || 0;
            return (sub * rate) / 100;
        };

        window.getJobNetTotal = function(job) {
            return window.getJobSubtotalBeforeTax(job) + window.getJobTaxAmount(job);
        };

        window.getJobBalanceDue = function(job) {
            const net = window.getJobNetTotal(job);
            if (job.payment === 'Paid') return 0;
            const adv = parseFloat(job.advance) || 0;
            return Math.max(0, net - adv);
        };

        window.calculateJobSubtotal = function() {
            let subtotal = 0;
            document.querySelectorAll('#jc-parts-container .item-row, #jc-labor-container .item-row').forEach(row => {
                const qty = parseFloat(row.querySelector('.row-qty').value) || 0;
                const price = parseFloat(row.querySelector('.row-price').value) || 0;
                subtotal += qty * price;
            });
            const outCharge = parseFloat(window.getEl('jc-outsource-charge')?.value) || 0;
            const discount = parseFloat(window.getEl('jc-discount')?.value) || 0;
            const advance = parseFloat(window.getEl('jc-advance')?.value) || 0;
            const payStatus = window.getEl('jc-payment')?.value || 'Pending';

            const subAfterDisc = Math.max(0, subtotal + outCharge - discount);
            const taxAmt = window.workshopSettings.taxEnabled ? (subAfterDisc * (parseFloat(window.workshopSettings.taxRate) || 0)) / 100 : 0;
            const net = subAfterDisc + taxAmt;
            const bal = payStatus === 'Paid' ? 0 : Math.max(0, net - advance);

            if (window.getEl('jc-net-total-display')) window.getEl('jc-net-total-display').innerText = `LKR ${net.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            if (window.getEl('jc-balance-due-display')) window.getEl('jc-balance-due-display').innerText = `LKR ${bal.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
        };

