        // --- DAILY CASHBOOK & FINANCIAL REPORT ---
        window.saveOpeningCash = function() {
            const d = window.getEl('cashbook-date-filter')?.value || TODAY_STR;
            const val = parseFloat(window.getEl('cb-opening-input')?.value) || 0;
            window.cashbookOpening[d] = val;
            saveState();
            window.renderCashbook();
            window.showToast(`Opening cash set for ${d}`);
        };

        window.renderCashbook = function() {
            const dateInput = window.getEl('cashbook-date-filter');
            if (dateInput && !dateInput.value) dateInput.value = TODAY_STR;
            const targetDate = dateInput ? dateInput.value : TODAY_STR;

            const opening = parseFloat(window.cashbookOpening[targetDate]) || 0;
            if (window.getEl('cb-opening-input')) window.getEl('cb-opening-input').value = opening;

            let cashIn = 0;
            window.jobCards.filter(j => j.date === targetDate).forEach(j => {
                if (j.payment === 'Paid') cashIn += window.getJobNetTotal(j);
                else cashIn += (parseFloat(j.advance) || 0);
            });

            let cashOut = 0;
            window.expenses.filter(e => e.date === targetDate).forEach(e => { cashOut += parseFloat(e.amount) || 0; });
            window.suppliers.filter(s => s.date === targetDate).forEach(s => { cashOut += parseFloat(s.paid) || 0; });

            const closing = opening + cashIn - cashOut;
            if (window.getEl('cb-cash-in')) window.getEl('cb-cash-in').innerText = `LKR ${cashIn.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            if (window.getEl('cb-cash-out')) window.getEl('cb-cash-out').innerText = `LKR ${cashOut.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            if (window.getEl('cb-closing-balance')) window.getEl('cb-closing-balance').innerText = `LKR ${closing.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
        };

        window.renderFinancialReport = function() {
            const monthFilter = window.getEl('report-month-filter')?.value || '';
            if (window.getEl('report-period-label')) window.getEl('report-period-label').innerText = monthFilter ? `Period: ${monthFilter}` : 'Period: All Records';

            const filteredJobs = monthFilter ? window.jobCards.filter(j => j.date.startsWith(monthFilter)) : window.jobCards;
            const filteredExp = monthFilter ? window.expenses.filter(e => e.date.startsWith(monthFilter)) : window.expenses;

            let collectedIncome = 0;
            let partsBuyingCost = 0;
            const mechMap = {};

            filteredJobs.forEach(j => {
                const net = window.getJobNetTotal(j);
                if (j.payment === 'Paid') collectedIncome += net;
                else collectedIncome += (parseFloat(j.advance) || 0);

                partsBuyingCost += (parseFloat(j.outsourceCost) || 0);
                let laborSum = 0;
                (j.items || []).forEach(it => {
                    if (it.category === 'Part') {
                        const inv = window.inventory.find(x => x.name.toLowerCase() === it.desc.toLowerCase());
                        if (inv) partsBuyingCost += (parseFloat(inv.cost) || 0) * (parseFloat(it.qty) || 0);
                    } else {
                        laborSum += (parseFloat(it.qty) || 0) * (parseFloat(it.price) || 0);
                    }
                });

                const mName = (j.mechanic || 'Unassigned').trim();
                if (!mechMap[mName]) mechMap[mName] = { jobs: 0, completed: 0, labor: 0, billed: 0 };
                mechMap[mName].jobs += 1;
                if (j.status === 'Completed') mechMap[mName].completed += 1;
                mechMap[mName].labor += laborSum;
                mechMap[mName].billed += net;
            });

            const totalExp = filteredExp.reduce((a, b) => a + (parseFloat(b.amount) || 0), 0);
            const exactProfit = collectedIncome - partsBuyingCost - totalExp;

            if (window.getEl('rep-total-income')) window.getEl('rep-total-income').innerText = `LKR ${collectedIncome.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            if (window.getEl('rep-buying-cost')) window.getEl('rep-buying-cost').innerText = `LKR ${partsBuyingCost.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            if (window.getEl('rep-total-expense')) window.getEl('rep-total-expense').innerText = `LKR ${totalExp.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            if (window.getEl('rep-net-profit')) window.getEl('rep-net-profit').innerText = `LKR ${exactProfit.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;

            const mechTbody = window.getEl('mechanic-performance-tbody');
            if (mechTbody) {
                const entries = Object.entries(mechMap);
                mechTbody.innerHTML = entries.length ? entries.map(([name, m]) => `
                    <tr>
                        <td class="p-2.5 font-bold">${name}</td>
                        <td class="p-2.5 text-center font-mono">${m.jobs}</td>
                        <td class="p-2.5 text-center font-mono">${m.completed}</td>
                        <td class="p-2.5 text-right font-mono">LKR ${m.labor.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                        <td class="p-2.5 text-right font-mono font-bold">LKR ${m.billed.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                    </tr>
                `).join('') : `<tr><td colspan="5" class="p-3 text-center text-slate-400">No mechanic performance data yet.</td></tr>`;
            }
        };

