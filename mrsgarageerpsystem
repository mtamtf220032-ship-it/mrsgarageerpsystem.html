                const notesEl = window.getEl('jc-notes');
                if (notesEl) notesEl.value = (notesEl.value ? notesEl.value + ' ' : '') + transcript;
                window.showToast('Voice note added!');
            };
            recognition.onerror = () => window.showToast('Voice capture stopped.');
            recognition.onend = () => {
                if (btn) btn.innerHTML = `<i class="fa-solid fa-microphone"></i> Voice Input`;
            };
            recognition.start();
