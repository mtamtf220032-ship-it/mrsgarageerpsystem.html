        window.renderFinancialReport = function () {
            const month = document.getElementById('report-month-filter').value;
            document.getElementById('report-period-label').textContent = month ? `Period: ${month}` : 'All Periods';

            const jobs = loadDB(KEYS.JOBS, []).filter(j => !month || (j.date || '').startsWith(month));
            const exps = loadDB(KEYS.EXPENSES, []).filter(e => !month || (e.date || '').startsWith(month));

            const income = jobs.reduce((a, j) => a + (parseFloat(j.paidAmount) || 0), 0);
            const expense = exps.reduce((a, e) => a + (parseFloat(e.amount) || 0), 0);
            const profit = income - expense;

            document.getElementById('rep-total-income').textContent = fmtMoney(income);
            document.getElementById('rep-buying-cost').textContent = fmtMoney(0);
            document.getElementById('rep-total-expense').textContent = fmtMoney(expense);
            document.getElementById('rep-net-profit').textContent = fmtMoney(profit);

            const mechMap = {};
            jobs.forEach(j => {
                const m = j.technician || 'Unassigned';
                if (!mechMap[m]) mechMap[m] = { jobs: 0, done: 0, labor: 0, billed: 0 };
                mechMap[m].jobs++;
                if (['Completed', 'Delivered'].includes(j.status)) mechMap[m].done++;
                mechMap[m].labor += (j.labor || []).reduce((a, l) => a + (l.total || 0), 0);
                mechMap[m].billed += (j.grandTotal || 0);
            });
            document.getElementById('mechanic-performance-tbody').innerHTML = Object.entries(mechMap).map(([name, st]) => `
                <tr>
                    <td class="p-2.5 font-bold">${escapeHtml(name)}</td>
                    <td class="p-2.5 text-center font-mono">${st.jobs}</td>
                    <td class="p-2.5 text-center font-mono">${st.done}</td>
                    <td class="p-2.5 text-right font-mono">${fmtMoney(st.labor)}</td>
                    <td class="p-2.5 text-right font-mono font-bold">${fmtMoney(st.billed)}</td>
                </tr>
            `).join('') || '<tr><td colspan="5" class="p-4 text-center text-slate-400">No mechanic job records for this period.</td></tr>';
        };

