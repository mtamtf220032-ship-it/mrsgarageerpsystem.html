            window.getEl('jc-discount').value = job.discount || 0;
            if (window.getEl('jc-advance')) window.getEl('jc-advance').value = job.advance || 0;
            if (window.getEl('jc-notes')) window.getEl('jc-notes').value = job.notes || '';
