        /* =========================================================================================
         * 6. PRINT PREVIEW, PAGE NUMBERS (Page 2-1, 2-2), WHATSAPP, SMS & CONVERT TO JOB CARD
         * ========================================================================================= */
        window.openPrintPreview = function (type, id) {
            currentPreviewState = { type, id };
            const record = type === 'quote'
                ? loadDB(KEYS.QUOTES, []).find(q => q.id === id)
                : loadDB(KEYS.JOBS, []).find(j => j.id === id);
            if (!record) return;

            const s = getSettings();
            document.getElementById('preview-vat-switch').checked = Boolean(record.includeVat);

            const bankWrap = document.getElementById('preview-bank-wrap');
            if (type === 'invoice') {
                bankWrap.classList.remove('hidden');
                bankWrap.classList.add('inline-flex');
                document.getElementById('preview-bank-switch').checked = Boolean(s.showBank);
            } else {
                bankWrap.classList.add('hidden');
                bankWrap.classList.remove('inline-flex');
            }

            const hpWrap = document.getElementById('preview-hideprice-wrap');
            if (type === 'job') {
                hpWrap.classList.remove('hidden');
                hpWrap.classList.add('inline-flex');
                document.getElementById('preview-hideprice-switch').checked = Boolean(record.hidePrices);
            } else {
                hpWrap.classList.add('hidden');
                hpWrap.classList.remove('inline-flex');
            }

            const convBtn = document.getElementById('preview-convert-btn');
            if (type === 'quote') {
                convBtn.classList.remove('hidden');
                convBtn.onclick = () => window.convertQuoteToJobCard(id);
            } else {
                convBtn.classList.add('hidden');
            }

            document.getElementById('preview-wa-btn').onclick = () => window.shareDocumentWhatsApp(type, id);
            document.getElementById('preview-sms-btn').onclick = () => window.shareDocumentSMS(type, id);

            renderPrintableSheet(type, record);
            document.getElementById('printPreviewModal').classList.remove('hidden');
        };

        window.togglePreviewOption = function (opt) {
            const { type, id } = currentPreviewState;
            if (opt === 'bank') {
                const s = getSettings();
                s.showBank = document.getElementById('preview-bank-switch').checked;
                saveDB(KEYS.SETTINGS, s);
                const rec = loadDB(KEYS.JOBS, []).find(j => j.id === id);
                if (rec) renderPrintableSheet(type, rec);
                return;
            }
            const key = type === 'quote' ? KEYS.QUOTES : KEYS.JOBS;
            const list = loadDB(key, []);
            const idx = list.findIndex(x => x.id === id);
            if (idx < 0) return;

            if (opt === 'vat') {
                const vatOn = document.getElementById('preview-vat-switch').checked;
                const s = getSettings();
                const afterDisc = Math.max(0, (list[idx].subtotal || 0) - (list[idx].discount || 0));
                const vatRate = parseFloat(s.taxRate) || 18;
                const vatAmount = vatOn ? Math.round(afterDisc * (vatRate / 100) * 100) / 100 : 0;
                const grandTotal = Math.round((afterDisc + vatAmount) * 100) / 100;
                const balanceDue = Math.max(0, Math.round((grandTotal - (list[idx].paidAmount || 0)) * 100) / 100);
                Object.assign(list[idx], { includeVat: vatOn, vatRate, vatAmount, grandTotal, balanceDue });
            } else if (opt === 'hidePrices') {
                list[idx].hidePrices = document.getElementById('preview-hideprice-switch').checked;
            }
            saveDB(key, list);
            renderPrintableSheet(type, list[idx]);
            refreshAllUI();
        };

